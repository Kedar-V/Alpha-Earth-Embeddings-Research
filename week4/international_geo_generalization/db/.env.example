# Copy to db/.env (never commit) and set a strong password.
# Also load these into the shell / job environment for experiment scripts.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aef_international
POSTGRES_USER=aef
POSTGRES_PASSWORD=change_me_to_a_strong_password

# Optional: connection URI (scripts prefer discrete vars above)
# DATABASE_URL=postgresql://aef:change_me_to_a_strong_password@127.0.0.1:5432/aef_international

# Local (non-Docker) cluster data directory when using micromamba PostGIS
PGDATA_DIR=/data/users/kv133/Alpha-Earth-Embeddings-Research/pgdata
